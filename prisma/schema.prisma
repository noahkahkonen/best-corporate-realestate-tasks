generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  passwordHash         String
  name                 String
  role                 Role
  mustChangePassword   Boolean  @default(false)
  createdAt            DateTime @default(now())
  tasksCreated         Task[]   @relation("TaskCreator")
  tasksAssigned        Task[]   @relation("TaskAssignee")
  helpMessagesAuthored HelpMessage[]
  passwordResetTokens  PasswordResetToken[]
  listingsCreated      Listing[] @relation("ListingCreator")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  AGENT
  MANAGER
  ADMIN
}

model Project {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f46e5")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  priority  Int @default(5)
  dueAt     DateTime?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  creatorId String?
  creator   User?    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignee     User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  reviewStatus    ReviewStatus    @default(PENDING_REVIEW)
  executionStatus ExecutionStatus @default(NOT_STARTED)
  managerNote     String?
  helpNote        String?
  isRedoRequest   Boolean         @default(false)
  redoRequestNote String?
  helpMessages    HelpMessage[]

  /// Set when the task is a drone shoot requested from the Drone Shots map.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([listingId])
}

model HelpMessage {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
  DENIED
}

enum ExecutionStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  NEEDS_HELP
}

/// A property pinned on the Drone Shots map. Added by hand from the portal —
/// there is no upstream listing feed to sync from.
model Listing {
  id           String  @id @default(cuid())
  name         String?
  address      String
  city         String?
  state        String?
  postalCode   String?
  propertyType String?
  latitude     Float
  longitude    Float

  photoStatus PhotoStatus @default(NO_PHOTOS)
  photoNote   String?
  lastShotAt  DateTime?
  archived    Boolean     @default(false)

  /// Listing agent initials and Sale/Lease/Sale-or-Lease, from the inventory sheet.
  agent    String?
  dealType String?

  /// Parcel outline for land with no usable address: an array of
  /// {lat, lng} vertices traced on the map, so the photographer knows
  /// exactly which ground is included.
  boundary Json?

  createdById String?
  createdBy   User?   @relation("ListingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Drone shoots are ordinary tasks, so they inherit manager approval,
  /// assignment, and the completed queue for free.
  droneTasks Task[]

  @@index([archived, photoStatus])
}

enum PhotoStatus {
  NO_PHOTOS
  NEEDS_MORE
  HAS_PHOTOS
}

