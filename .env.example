# 1) Copy this file: cp .env.example .env
# 2) Replace placeholders with real values. Never commit .env (gitignored).

# PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Notification email (Resend — https://resend.com/api-keys).
# Leave RESEND_API_KEY unset to disable sending: notifications are logged to the
# console instead, which is usually what you want in local development.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, or sends will be rejected.
EMAIL_FROM="Task Portal <notifications@bestcorporaterealestate-tasks.com>"
# Absolute base URL used for links in emails (no trailing slash).
APP_URL="https://bestcorporaterealestate-tasks.com"

# --- Drone Shots map -------------------------------------------------------
# Browser key: loads the map, the pins, and the address search box. This one is
# public by definition, so restrict it by HTTP referrer in the Cloud Console
# and enable only Maps JavaScript API, Places API, and Directions API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key: address -> coordinates when a listing is added by hand. Keep it
# unrestricted-by-referrer but locked to the Geocoding API. Falls back to the
# browser key above if unset.
GOOGLE_MAPS_API_KEY=""
# Cloud-console Map ID. Required for the coloured pins to render; DEMO_MAP_ID
# works for development but should be replaced with a real one in production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# Home base. The map opens here, routes leave from and return here, flight
# conditions are reported here, and address search is biased around here.
# Defaults to downtown Columbus; set all three to move the tab to another
# office. NEXT_PUBLIC_ because the map and route planner read these in the
# browser while the conditions panel reads them on the server.
NEXT_PUBLIC_DRONE_HOME_LAT="39.9612"
NEXT_PUBLIC_DRONE_HOME_LNG="-82.9988"
NEXT_PUBLIC_DRONE_HOME_LABEL="Columbus, OH"

# IANA timezone for sunrise, sunset, and the forecast strip. Without this the
# server's clock is used, and Vercel runs in UTC.
DRONE_TIMEZONE="America/New_York"
